rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember(tenantId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)).data.status == 'active';
    }

    // Default deny rule
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Tenant and branch isolated document storage
    match /tenants/{tenantId}/branches/{branchId}/{category}/{fileName} {
      allow read: if isMember(tenantId);
      // Validates file size (< 15MB) and supported image/PDF content types
      allow write: if isMember(tenantId) &&
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
