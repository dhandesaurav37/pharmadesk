rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getMembership(tenantId) {
      return firestore.get(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid));
    }

    function isMember(tenantId) {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/tenants/$(tenantId)/memberships/$(request.auth.uid)) &&
        getMembership(tenantId).data.status == 'active';
    }

    function hasBranchAccess(tenantId, branchId) {
      return isMember(tenantId) && (
        getMembership(tenantId).data.role == 'owner' ||
        ('*' in getMembership(tenantId).data.assignedBranchIds) ||
        (branchId in getMembership(tenantId).data.assignedBranchIds)
      );
    }

    function isAllowedCategory(category) {
      return category in ['invoice_pdfs', 'prescriptions', 'supplier_bills', 'product_images', 'documents'];
    }

    // Default deny rule
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Tenant and branch isolated document storage
    match /tenants/{tenantId}/branches/{branchId}/{category}/{fileName} {
      allow read: if isAllowedCategory(category) && hasBranchAccess(tenantId, branchId);
      // Validates category, branch membership, file size (< 15MB), and image/PDF content types
      allow write: if isAllowedCategory(category) &&
        hasBranchAccess(tenantId, branchId) &&
        request.resource.size < 15 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }
  }
}
