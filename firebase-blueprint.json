{
  "entities": {
    "Tenant": {
      "collection": "tenants",
      "path": "tenants/{tenantId}",
      "description": "Primary multi-tenant pharmacy root entity isolating all business data.",
      "fields": {
        "id": { "type": "string", "description": "Unique tenant slug / ID" },
        "name": { "type": "string", "description": "Pharmacy commercial name" },
        "legalName": { "type": "string", "description": "Registered legal entity name" },
        "dlNumber20B": { "type": "string", "description": "Drug license 20B (allopathic non-specified)" },
        "dlNumber21B": { "type": "string", "description": "Drug license 21B (specified drugs)" },
        "gstin": { "type": "string", "description": "15-character Indian Goods and Services Tax ID" },
        "pan": { "type": "string", "description": "Permanent Account Number" },
        "address": { "type": "string", "description": "Physical pharmacy street address" },
        "city": { "type": "string", "description": "City / town" },
        "state": { "type": "string", "description": "Indian State" },
        "pincode": { "type": "string", "description": "6-digit postal pincode" },
        "contactPhone": { "type": "string", "description": "Primary phone" },
        "contactEmail": { "type": "string", "description": "Official email" },
        "ownerId": { "type": "string", "description": "Firebase Auth UID of the owner" },
        "status": { "type": "string", "enum": ["active", "suspended", "cancelled"] },
        "plan": { "type": "string", "enum": ["standard", "growth", "enterprise"] }
      }
    },
    "Membership": {
      "collection": "memberships",
      "path": "tenants/{tenantId}/memberships/{userId}",
      "description": "Live tenant membership, RBAC role definition, branch assignments, and custom overrides.",
      "fields": {
        "tenantId": { "type": "string" },
        "userId": { "type": "string", "description": "Firebase Auth UID of the member" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "pharmacist", "cashier", "helper", "auditor"] },
        "status": { "type": "string", "enum": ["active", "invited", "deactivated", "suspended"] },
        "assignedBranchIds": { "type": "array", "description": "List of branch IDs the member has access to, or ['*']" },
        "permissions": { "type": "array", "description": "Effective capability strings" },
        "permissionOverrides": { "type": "object", "description": "Explicit granted and revoked overrides" },
        "invitedBy": { "type": "string" }
      }
    },
    "Invitation": {
      "collection": "invitations",
      "path": "tenants/{tenantId}/invitations/{invitationId}",
      "description": "Secure employee invitation lifecycle record with 72-hour TTL.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "pharmacist", "cashier", "helper", "auditor"] },
        "assignedBranchIds": { "type": "array" },
        "permissionOverrides": { "type": "object" },
        "token": { "type": "string", "description": "Cryptographically secure random acceptance token" },
        "status": { "type": "string", "enum": ["pending", "accepted", "expired", "cancelled", "revoked"] },
        "expiresAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" },
        "acceptedByUserId": { "type": "string" },
        "acceptedAt": { "type": "string" }
      }
    },
    "Branch": {
      "collection": "branches",
      "path": "tenants/{tenantId}/branches/{branchId}",
      "description": "Counter or physical location within a pharmacy tenant.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "branchCode": { "type": "string" },
        "isMain": { "type": "boolean" },
        "status": { "type": "string" }
      }
    },
    "Medicine": {
      "collection": "medicines",
      "path": "tenants/{tenantId}/medicines/{medicineId}",
      "description": "Master drug formulary record with salt composition, dosage form, schedule, HSN, and GST.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "name": { "type": "string", "description": "Brand trade name" },
        "genericName": { "type": "string", "description": "Salt formulation composition" },
        "brand": { "type": "string", "description": "Manufacturer or pharma company" },
        "category": { "type": "string" },
        "dosageForm": { "type": "string" },
        "strength": { "type": "string" },
        "packSize": { "type": "string" },
        "uom": { "type": "string" },
        "hsnCode": { "type": "string" },
        "gstRate": { "type": "number" },
        "barcode": { "type": "string" },
        "prescriptionRequired": { "type": "boolean" },
        "minStockThreshold": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "inactive", "archived"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "InventoryBatch": {
      "collection": "inventory_batches",
      "path": "tenants/{tenantId}/inventory_batches/{batchId}",
      "description": "Tracked medicine batch with expiry, PTR purchase price, MRP, and available stock balance.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "medicineId": { "type": "string" },
        "medicineName": { "type": "string" },
        "genericName": { "type": "string" },
        "batchNumber": { "type": "string" },
        "manufacturingDate": { "type": "string" },
        "expiryDate": { "type": "string" },
        "purchasePrice": { "type": "number", "description": "Wholesale PTR rate" },
        "mrp": { "type": "number", "description": "Maximum Retail Price" },
        "sellingPrice": { "type": "number" },
        "quantityReceived": { "type": "number" },
        "currentStock": { "type": "number", "description": "Available sellable stock units" },
        "freeQuantity": { "type": "number" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "rackLocation": { "type": "string" },
        "status": { "type": "string", "enum": ["normal", "low_stock", "near_expiry", "expired", "out_of_stock"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "StockMovement": {
      "collection": "stock_movements",
      "path": "tenants/{tenantId}/stock_movements/{movementId}",
      "description": "Append-only immutable stock transaction audit log.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "medicineId": { "type": "string" },
        "batchId": { "type": "string" },
        "batchNumber": { "type": "string" },
        "medicineName": { "type": "string" },
        "movementType": {
          "type": "string",
          "enum": [
            "OPENING_STOCK",
            "PURCHASE_RECEIPT",
            "SALE",
            "SALE_RETURN",
            "INVOICE_CANCEL_REVERSAL",
            "PURCHASE_RETURN",
            "DAMAGE",
            "EXPIRY",
            "MANUAL_ADJUSTMENT",
            "STOCK_TRANSFER_IN",
            "STOCK_TRANSFER_OUT"
          ]
        },
        "quantityChange": { "type": "number" },
        "previousQuantity": { "type": "number" },
        "newQuantity": { "type": "number" },
        "referenceType": { "type": "string" },
        "referenceId": { "type": "string" },
        "reason": { "type": "string" },
        "performedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "SalesInvoice": {
      "collection": "sales_invoices",
      "path": "tenants/{tenantId}/sales_invoices/{invoiceId}",
      "description": "Permanent immutable customer retail sale invoice with GST breakdown and line items.",
      "fields": {
        "id": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "customerId": { "type": "string" },
        "customer": { "type": "object" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "totalDiscount": { "type": "number" },
        "taxableAmount": { "type": "number" },
        "cgst": { "type": "number" },
        "sgst": { "type": "number" },
        "igst": { "type": "number" },
        "roundOff": { "type": "number" },
        "grandTotal": { "type": "number" },
        "amountPaid": { "type": "number" },
        "khataCreditAmount": { "type": "number" },
        "balanceDue": { "type": "number" },
        "creditTermsDays": { "type": "number" },
        "dueDate": { "type": "string" },
        "totalRefunded": { "type": "number" },
        "refundStatus": { "type": "string", "enum": ["not_applicable", "refund_pending", "refunded"] },
        "refundAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "partial", "unpaid"] },
        "payments": { "type": "array" },
        "status": { "type": "string", "enum": ["completed", "cancelled", "partially_returned", "returned"] },
        "isInterState": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Payment": {
      "collection": "payments",
      "path": "tenants/{tenantId}/sales_invoices/{invoiceId}/payments/{paymentId}",
      "description": "Payment transaction record against sales invoice (cash, UPI, card, bank transfer, khata).",
      "fields": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "mode": { "type": "string", "enum": ["cash", "upi", "card", "bank_transfer", "khata_credit"] },
        "amount": { "type": "number" },
        "referenceNumber": { "type": "string" },
        "recordedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "SalesReturn": {
      "collection": "returns",
      "path": "tenants/{tenantId}/sales_invoices/{invoiceId}/returns/{returnId}",
      "description": "Sales return record capturing returned items, batch stock restocks, and refunds.",
      "fields": {
        "id": { "type": "string" },
        "invoiceId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "returnedByUserId": { "type": "string" },
        "items": { "type": "array" },
        "totalRefundAmount": { "type": "number" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "IdempotencyKey": {
      "collection": "idempotency_keys",
      "path": "tenants/{tenantId}/idempotency_keys/{key}",
      "description": "Tenant- and branch-scoped deduplication and replay safety for checkout, payment, return, cancel, and Khata ledger transactions.",
      "fields": {
        "key": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "operation": { "type": "string", "enum": ["checkout", "payment", "return", "cancel", "khata_payment", "credit_note", "balance_adjustment"] },
        "payloadHash": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed"] },
        "result": { "type": "object" },
        "completedAt": { "type": "string" }
      }
    },
    "Customer": {
      "collection": "customers",
      "path": "tenants/{tenantId}/customers/{customerId}",
      "description": "Tenant-isolated pharmacy customer / patient / institutional credit account with Khata ledger balances.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "primaryBranchId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "normalizedPhone": { "type": "string" },
        "alternatePhone": { "type": "string" },
        "email": { "type": "string" },
        "customerType": { "type": "string", "enum": ["REGULAR", "VIP", "CHRONIC", "CORPORATE", "CLINIC", "SENIOR_CITIZEN"] },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "pincode": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string", "enum": ["MALE", "FEMALE", "OTHER", "PREFER_NOT_TO_SAY"] },
        "preferredDoctorName": { "type": "string" },
        "allergies": { "type": "string" },
        "chronicConditions": { "type": "string" },
        "gstin": { "type": "string" },
        "creditEnabled": { "type": "boolean" },
        "creditLimit": { "type": "number" },
        "creditTermsDays": { "type": "number" },
        "currentOutstandingBalance": { "type": "number" },
        "advanceBalance": { "type": "number" },
        "totalPurchases": { "type": "number" },
        "totalPayments": { "type": "number" },
        "totalVisits": { "type": "number" },
        "lastPurchaseDate": { "type": "string" },
        "lastPaymentDate": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "BLOCKED"] },
        "isArchived": { "type": "boolean" },
        "notes": { "type": "string" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "CustomerLedgerEntry": {
      "collection": "ledger",
      "path": "tenants/{tenantId}/customers/{customerId}/ledger/{entryId}",
      "description": "Append-only immutable double-sided Khata ledger transaction entry.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "customerId": { "type": "string" },
        "entryType": {
          "type": "string",
          "enum": [
            "CREDIT_PURCHASE",
            "CASH_PAYMENT",
            "UPI_PAYMENT",
            "CARD_PAYMENT",
            "BANK_TRANSFER",
            "CREDIT_NOTE",
            "DEBIT_ADJUSTMENT",
            "CREDIT_ADJUSTMENT",
            "OPENING_BALANCE",
            "REFUND"
          ]
        },
        "direction": { "type": "string", "enum": ["DEBIT", "CREDIT"] },
        "amount": { "type": "number" },
        "previousBalance": { "type": "number" },
        "runningBalance": { "type": "number" },
        "advanceDelta": { "type": "number" },
        "runningAdvanceBalance": { "type": "number" },
        "referenceType": { "type": "string" },
        "referenceId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "paymentId": { "type": "string" },
        "returnId": { "type": "string" },
        "paymentMode": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "description": { "type": "string" },
        "reason": { "type": "string" },
        "operationRef": { "type": "string" },
        "performedBy": { "type": "string" },
        "performedByName": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "CustomerPayment": {
      "collection": "payments",
      "path": "tenants/{tenantId}/customers/{customerId}/payments/{paymentId}",
      "description": "Authoritative customer Khata payment receipt including invoice allocations.",
      "fields": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "customerId": { "type": "string" },
        "amount": { "type": "number" },
        "appliedToBalance": { "type": "number" },
        "addedToAdvance": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["cash", "upi", "card", "bank_transfer"] },
        "referenceNumber": { "type": "string" },
        "paymentDate": { "type": "string" },
        "allocations": { "type": "array" },
        "notes": { "type": "string" },
        "recordedBy": { "type": "string" },
        "recordedByName": { "type": "string" },
        "ledgerEntryId": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    },
    "User": {
      "collection": "users",
      "path": "users/{uid}",
      "description": "Global user identity registry mapping Firebase Auth users to memberships.",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "lastActiveTenantId": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "AuditLog": {
      "collection": "audit_logs",
      "path": "tenants/{tenantId}/audit_logs/{logId}",
      "description": "Append-only immutable audit trail capturing staff lifecycle, stock, billing, and security events.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "action": { "type": "string" },
        "actingUserId": { "type": "string" },
        "targetUserId": { "type": "string" },
        "metadata": { "type": "object" },
        "timestamp": { "type": "string" }
      }
    },
    "Counter": {
      "collection": "counters",
      "path": "tenants/{tenantId}/counters/{counterId}",
      "description": "Atomic sequential invoice, PO, GRN, and voucher counter per branch and year inside Firestore runTransaction.",
      "fields": {
        "currentSeq": { "type": "number" },
        "updatedAt": { "type": "string" }
      }
    },
    "Supplier": {
      "collection": "suppliers",
      "path": "tenants/{tenantId}/suppliers/{supplierId}",
      "description": "Pharmaceutical distributor/wholesaler profile, license, GST, payment terms, bank details, and payable balance.",
      "fields": {
        "supplierId": { "type": "string" },
        "tenantId": { "type": "string" },
        "supplierCode": { "type": "string" },
        "legalName": { "type": "string" },
        "tradeName": { "type": "string" },
        "contactPerson": { "type": "string" },
        "primaryPhone": { "type": "string" },
        "gstin": { "type": "string" },
        "pan": { "type": "string" },
        "state": { "type": "string" },
        "stateCode": { "type": "string" },
        "drugLicenceNumber": { "type": "string" },
        "supplierType": { "type": "string", "enum": ["DISTRIBUTOR", "MANUFACTURER", "C_AND_F", "WHOLESALER", "SURGICAL_VENDOR", "GENERIC_STOCKIST"] },
        "paymentTerms": { "type": "string" },
        "creditPeriodDays": { "type": "number" },
        "creditLimit": { "type": "number" },
        "openingBalance": { "type": "number" },
        "currentOutstandingBalance": { "type": "number" },
        "advanceBalance": { "type": "number" },
        "bankDetails": { "type": "object" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "BLOCKED"] },
        "isArchived": { "type": "boolean" }
      }
    },
    "PurchaseOrder": {
      "collection": "purchaseOrders",
      "path": "tenants/{tenantId}/purchaseOrders/{purchaseOrderId}",
      "description": "Branch-scoped procurement order commitment with approval workflow and pending quantity tracking.",
      "fields": {
        "purchaseOrderId": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "purchaseOrderNumber": { "type": "string" },
        "supplierId": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "PENDING_APPROVAL", "APPROVED", "PARTIALLY_RECEIVED", "FULLY_RECEIVED", "CANCELLED", "CLOSED"] },
        "items": { "type": "array" },
        "cgst": { "type": "number" },
        "sgst": { "type": "number" },
        "igst": { "type": "number" },
        "grandTotal": { "type": "number" }
      }
    },
    "GoodsReceipt": {
      "collection": "goodsReceipts",
      "path": "tenants/{tenantId}/goodsReceipts/{grnId}",
      "description": "Goods Receipt Note recording physical delivery, accepted/rejected splits, and batch-level inward creation.",
      "fields": {
        "grnId": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "grnNumber": { "type": "string" },
        "purchaseOrderId": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierInvoiceNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "POSTED", "REVERSED"] },
        "items": { "type": "array" },
        "grandTotal": { "type": "number" }
      }
    },
    "SupplierInvoice": {
      "collection": "supplierInvoices",
      "path": "tenants/{tenantId}/supplierInvoices/{invoiceId}",
      "description": "Single authoritative payable liability linked cleanly to GRN without duplicate liability recognition.",
      "fields": {
        "invoiceId": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "supplierId": { "type": "string" },
        "grnId": { "type": "string" },
        "supplierInvoiceNumber": { "type": "string" },
        "invoiceAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "outstandingAmount": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["UNPAID", "PARTIALLY_PAID", "PAID", "OVERDUE", "REVERSED"] }
      }
    },
    "SupplierPayment": {
      "collection": "supplierPayments",
      "path": "tenants/{tenantId}/supplierPayments/{paymentId}",
      "description": "Idempotent supplier payment disbursements allocated across supplier invoices or advance.",
      "fields": {
        "paymentId": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "supplierId": { "type": "string" },
        "voucherNumber": { "type": "string" },
        "amount": { "type": "number" },
        "allocations": { "type": "array" }
      }
    },
    "SupplierReturn": {
      "collection": "supplierReturns",
      "path": "tenants/{tenantId}/supplierReturns/{returnId}",
      "description": "Controlled stock return to supplier with credit note tracking and batch inventory deduction.",
      "fields": {
        "returnId": { "type": "string" },
        "tenantId": { "type": "string" },
        "branchId": { "type": "string" },
        "supplierId": { "type": "string" },
        "grnId": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING_APPROVAL", "APPROVED", "POSTED", "REJECTED"] },
        "totalReturnAmount": { "type": "number" }
      }
    },
    "PurchaseOperation": {
      "collection": "purchaseOperations",
      "path": "tenants/{tenantId}/purchaseOperations/{operationId}",
      "description": "Recoverable state-machine log tracking GRN posting, reversals, and supplier returns.",
      "fields": {
        "operationId": { "type": "string" },
        "operationType": { "type": "string" },
        "status": { "type": "string", "enum": ["STARTED", "COMMITTED", "FAILED", "REVERSED"] },
        "idempotencyKey": { "type": "string" }
      }
    },
    "ChartOfAccount": {
      "collection": "chartOfAccounts",
      "path": "tenants/{tenantId}/chartOfAccounts/{accountId}",
      "description": "General Ledger account definition in the 5 standard Indian pharmacy accounting categories.",
      "fields": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
