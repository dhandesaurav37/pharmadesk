# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# PHARMADESK BACKEND SERVER CONFIGURATION (CLOUD RUN - asia-south1)
# ==============================================================================

# Server execution environment: 'development', 'production', or 'test'
NODE_ENV="development"

# Server listener port (defaults to 3001 in local development; 8080 on Cloud Run)
PORT="3001"

# Server bind host (defaults to 0.0.0.0)
HOST="0.0.0.0"

# Structured logging level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL="info"

# API routing prefix
API_PREFIX="/api/v1"

# Comma-separated list of browser origins permitted by CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://pharmadesk-cloud.web.app"

# Rate limiting window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS="900000"

# Maximum requests permitted per window per IP
RATE_LIMIT_MAX_REQUESTS="1000"

# ==============================================================================
# FIREBASE ADMIN SDK & SERVICES CONFIGURATION (SOLE BACKEND PLATFORM)
# ==============================================================================

# Firebase / Google Cloud Project ID (Region: asia-south1 Mumbai)
FIREBASE_PROJECT_ID="pharmadesk-cloud"

# Firebase Cloud Storage Bucket
FIREBASE_STORAGE_BUCKET="pharmadesk-cloud.appspot.com"

# Enforce Firebase App Check token verification on protected API requests ('true' in production)
FIREBASE_APP_CHECK_REQUIRED="false"

# Optional service-account credentials for local development only.
# On Google Cloud Run, leave these unset and rely on Workload Identity / ADC.
# NEVER commit real private keys or service-account JSON files to Git.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Local Firebase Emulator Suite hosts (uncomment for local emulator testing)
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIREBASE_STORAGE_EMULATOR_HOST="127.0.0.1:9199"

# Cloud Run / reverse proxy trust setting ('1' in Cloud Run production, 'false' locally)
TRUST_PROXY="false"

# Phase 11: Backup, Disaster Recovery & DPDP Compliance Targets
BACKUP_BUCKET_NAME="pharmadesk-cloud-firestore-backups"
DR_RPO_MINUTES="5"
DR_RTO_MINUTES="30"
AUDIT_LOG_RETENTION_DAYS="365"
DPDP_EXPORT_TTL_MINUTES="15"

# ==============================================================================
# FRONTEND CLIENT CONFIGURATION (FIREBASE HOSTING + VITE)
# ==============================================================================
# Safe public Firebase Web SDK configuration (no Admin credentials here)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="pharmadesk-cloud.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="pharmadesk-cloud"
VITE_FIREBASE_STORAGE_BUCKET="pharmadesk-cloud.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_API_BASE_URL="/api/v1"
