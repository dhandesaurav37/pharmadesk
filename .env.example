# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# PHARMADESK BACKEND SERVER CONFIGURATION (PHASE 1)
# ==============================================================================

# Server execution environment: 'development', 'production', or 'test'
NODE_ENV="development"

# Server listener port (defaults to 3001 in local development; 8080 on Cloud Run)
PORT="3001"

# Server bind host (defaults to 0.0.0.0)
HOST="0.0.0.0"

# Structured logging level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL="info"

# API routing prefix
API_PREFIX="/api/v1"

# Comma-separated list of browser origins permitted by CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Rate limiting window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS="900000"

# Maximum requests permitted per window per IP
RATE_LIMIT_MAX_REQUESTS="1000"

# ==============================================================================
# PHARMADESK POSTGRESQL DATABASE CONFIGURATION (PHASE 2)
# ==============================================================================

# Primary connection string (Cloud SQL / Production or local direct connection)
# Example: postgresql://pharmadesk_app:strongpassword@127.0.0.1:5432/pharmadesk?sslmode=disable
DATABASE_URL=""

# Individual connection parameters (used when DATABASE_URL is not set)
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="pharmadesk"
DB_USER="pharmadesk_app"
DB_PASSWORD="change_me_in_production"
DB_SSL="false"

# Connection pool sizing and timeouts
DB_POOL_MIN="2"
DB_POOL_MAX="10"
DB_CONNECTION_TIMEOUT_MS="5000"
DB_IDLE_TIMEOUT_MS="30000"

# Schema migration user (runs with DDL and BYPASSRLS privileges, CI/CD only)
DB_MIGRATOR_USER="pharmadesk_migrator"
DB_MIGRATOR_PASSWORD="migrator_password"

