# ==============================================================================
# PharmaDesk Environment Configuration Template
# Copy to `.env` for local development or inject via Cloud Secret Manager /
# Cloud Run environment variables (staging & production).
# NEVER commit real private keys, API keys, or service-account JSON files.
# ==============================================================================

# --- Backend Runtime & Cloud Run ---
# Environment mode: development | test | production
NODE_ENV=development
# Cloud Run injects PORT=8080 in production; local Express dev server uses 3001
PORT=3001
HOST=0.0.0.0
# Structured Pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# API route prefix (must start with /)
API_PREFIX=/api/v1
# Set to 1 behind Cloud Run / Firebase Hosting reverse proxy in production
TRUST_PROXY=false

# --- CORS & Edge Rate Limiting ---
# Comma-separated explicit origins.
# PRODUCTION REQUIREMENT: Wildcard "*" and localhost/127.0.0.1 are blocked in production.
# Example production: https://pharmadesk-cloud.web.app,https://pharmadesk-cloud.firebaseapp.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# --- Firebase Admin SDK (Backend) ---
# Target Firebase / GCP project ID (existing: pharmadesk-cloud)
FIREBASE_PROJECT_ID=pharmadesk-cloud
# Default Firebase Storage bucket
FIREBASE_STORAGE_BUCKET=pharmadesk-cloud.appspot.com
# Optional local/non-Workload-Identity service account credentials (stored in Secret Manager in GCP;
# omit on Cloud Run when using dedicated Workload Identity Service Account ADC)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Enable strict X-Firebase-AppCheck token verification on protected API routes ONLY after
# client App Check attestation (ReCaptcha site key) is verified end-to-end in staging
FIREBASE_APP_CHECK_REQUIRED=false

# --- Local Firebase Emulator Suite (Development / CI Rules Tests Only) ---
# Leave unset in staging/production
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# --- Phase 11 / 12 Compliance, Retention & Disaster Recovery ---
# GCS Coldline backup bucket in asia-south1 (Mumbai)
BACKUP_BUCKET_NAME=gs://pharmadesk-cloud-firestore-backups/asia-south1
DR_RPO_MINUTES=5
DR_RTO_MINUTES=30
AUDIT_LOG_RETENTION_DAYS=365
DPDP_EXPORT_TTL_MINUTES=15

# --- Optional Server-Side Gemini API Key (Keep server-side only; never VITE_ prefixed) ---
GEMINI_API_KEY=

# ==============================================================================
# Frontend Public Configuration (Vite Build-Time Variables — Safe to Expose)
# ==============================================================================
# Leave empty when deployed on Firebase Hosting (uses same-origin /api/** rewrite
# to Cloud Run service pharmadesk-api in asia-south1) or Vite dev proxy.
# Set only when frontend and backend are hosted on separate domains.
VITE_API_BASE_URL=

# Firebase Web App public configuration (from Firebase Console -> Project Settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=pharmadesk-cloud.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pharmadesk-cloud
VITE_FIREBASE_STORAGE_BUCKET=pharmadesk-cloud.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check web attestation (reCAPTCHA v3 or Enterprise site key; public key)
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=
# App Check provider type: v3 | enterprise
VITE_FIREBASE_APPCHECK_PROVIDER=v3
# Optional local Auth Emulator URL for dev only (e.g., http://127.0.0.1:9099)
VITE_FIREBASE_AUTH_EMULATOR_URL=