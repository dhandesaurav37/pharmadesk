{
  "name": "pharmadesk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:frontend": "vite --port=3000 --host=0.0.0.0",
    "dev:backend": "tsx server/src/server.ts",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:backend": "tsc -p server/tsconfig.json",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "vitest run",
    "test:backend": "vitest run server/tests",
    "lint": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "db:migrate": "tsx server/scripts/migrate.ts",
    "db:status": "tsx server/scripts/migration-status.ts",
    "db:check": "tsx server/scripts/db-check.ts",
    "validate": "npm run lint && npm run test && npm run build:frontend"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "supertest": "^7.3.1",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
